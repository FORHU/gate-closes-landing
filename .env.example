# Public URL of the site, used for share links, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://gate-closes.com

# Extra dev-server origins allowed to load /_next assets (comma separated),
# e.g. your PC's LAN IP when testing from a phone. Leave empty otherwise.
ALLOWED_DEV_ORIGINS=

# gate-closes-api base URL (no /api). Server-side only: the admin area calls
# it through /backend/* on this site. This site's own URL must be in the
# API's ALLOWED_ORIGINS (http://localhost:3000 already is).
API_URL=http://localhost:3001
